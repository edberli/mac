{
 "head": [
  "WHAT YOU REALLY",
  "SEE FROM SPACE"
 ],
 "duration": 34.267,
 "captions": [
  {
   "start": 0.054,
   "end": 2.631,
   "text": "So what can you actually see from up here?"
  },
  {
   "start": 2.781,
   "end": 6.277,
   "text": "This station circles the Earth every 90 minutes."
  },
  {
   "start": 6.277,
   "end": 8.025,
   "text": "16 sunrises a day."
  },
  {
   "start": 8.025,
   "end": 9.653,
   "text": "Watch the night side."
  },
  {
   "start": 11.003,
   "end": 13.661,
   "text": "Whoa... those lights."
  },
  {
   "start": 13.811,
   "end": 14.614,
   "text": "Cities."
  },
  {
   "start": 14.614,
   "end": 17.271,
   "text": "Most borders are invisible from here."
  },
  {
   "start": 17.271,
   "end": 19.558,
   "text": "A few are lit up with floodlights,"
  },
  {
   "start": 19.558,
   "end": 21.288,
   "text": "and those you can see."
  },
  {
   "start": 21.438,
   "end": 23.284,
   "text": "Up here, a border only shows up"
  },
  {
   "start": 23.284,
   "end": 25.455,
   "text": "if someone switches the lights on."
  },
  {
   "start": 25.705,
   "end": 27.596,
   "text": "And that green glow?"
  },
  {
   "start": 27.696,
   "end": 28.651,
   "text": "An aurora."
  },
  {
   "start": 28.651,
   "end": 31.994,
   "text": "And those flashes in the clouds are thunderstorms."
  },
  {
   "start": 31.994,
   "end": 34.023,
   "text": "You're looking down on them."
  }
 ]
}