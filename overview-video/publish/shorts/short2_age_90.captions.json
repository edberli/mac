{
 "head": [
  "SPACE AT AGE 90",
  "HE DIDN'T FEEL JOY"
 ],
 "duration": 23.1,
 "captions": [
  {
   "start": 0.0,
   "end": 1.978,
   "text": "In 2021, an actor"
  },
  {
   "start": 1.978,
   "end": 4.446,
   "text": "who played a starship captain for decades"
  },
  {
   "start": 4.446,
   "end": 5.951,
   "text": "finally flew to space,"
  },
  {
   "start": 5.951,
   "end": 7.516,
   "text": "at 90 years old."
  },
  {
   "start": 7.666,
   "end": 9.558,
   "text": "Afterwards, he said"
  },
  {
   "start": 9.558,
   "end": 12.568,
   "text": "what he felt most wasn't joy."
  },
  {
   "start": 12.568,
   "end": 14.202,
   "text": "It was grief."
  },
  {
   "start": 14.452,
   "end": 16.727,
   "text": "Grief? Why?"
  },
  {
   "start": 16.877,
   "end": 19.469,
   "text": "Below him was everything."
  },
  {
   "start": 19.469,
   "end": 22.647,
   "text": "Above him, nothing but black."
  }
 ]
}