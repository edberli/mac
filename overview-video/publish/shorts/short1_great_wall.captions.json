{
 "head": [
  "THE GREAT WALL",
  "FROM SPACE?"
 ],
 "duration": 40.3,
 "captions": [
  {
   "start": 0.15,
   "end": 2.901,
   "text": "Wait... where's the Great Wall?"
  },
  {
   "start": 3.051,
   "end": 4.397,
   "text": "With your eyes?"
  },
  {
   "start": 4.397,
   "end": 6.127,
   "text": "You'll never find it."
  },
  {
   "start": 6.527,
   "end": 9.583,
   "text": "But everyone says it's the one thing humans built"
  },
  {
   "start": 9.583,
   "end": 11.704,
   "text": "that you can see from space."
  },
  {
   "start": 11.854,
   "end": 13.2,
   "text": "Everyone's wrong."
  },
  {
   "start": 13.517,
   "end": 14.942,
   "text": "I can't see it."
  },
  {
   "start": 14.942,
   "end": 16.367,
   "text": "Not even close."
  },
  {
   "start": 16.517,
   "end": 19.223,
   "text": "The wall is only about 6 meters wide."
  },
  {
   "start": 19.223,
   "end": 21.147,
   "text": "From 400 kilometers,"
  },
  {
   "start": 21.147,
   "end": 23.252,
   "text": "that's like trying to spot a pencil"
  },
  {
   "start": 23.252,
   "end": 25.236,
   "text": "from half a kilometer away."
  },
  {
   "start": 25.486,
   "end": 27.505,
   "text": "Then why does everyone say you can?"
  },
  {
   "start": 27.655,
   "end": 31.968,
   "text": "The claim was already written down in 1754."
  },
  {
   "start": 31.968,
   "end": 35.817,
   "text": "The first human reached space in 1961."
  },
  {
   "start": 35.917,
   "end": 38.271,
   "text": "People repeated it for 200 years"
  },
  {
   "start": 38.271,
   "end": 40.154,
   "text": "before anyone could check."
  }
 ]
}